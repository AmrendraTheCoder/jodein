# .env.example — copy this to .env and fill in real values

# ─── DEMO MODE ───────────────────────────────────────────
# Set to true to use the browser chat UI instead of real WhatsApp.
# The full pipeline (Redis, Gemini, BullMQ) still runs — only the
# Meta API is bypassed. Flip to false when you have a real Meta account.
DEMO_MODE=true

# ─── Meta / WhatsApp ─────────────────────────────────────
# (Not needed while DEMO_MODE=true — fill in when going production)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_access_token_here
WEBHOOK_VERIFY_TOKEN=any_random_string_you_choose   # e.g. jodein_secret_2024
META_APP_SECRET=your_meta_app_secret_here

# ─── MongoDB Atlas ───────────────────────────────────────
# Step 11+: Multi-tenant college configs, student records, message logs
# Create free M0 cluster at: https://cloud.mongodb.com
# Format: mongodb+srv://user:pass@cluster.mongodb.net/jodein
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/jodein

# ─── Admin API Secret ────────────────────────────────────
# Protects /admin/* routes until proper auth is added in Step 19
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=generate_a_long_random_string_here

# ─── Upstash Redis ───────────────────────────────────────
# For conversation history + deduplication + demo reply storage
# Create free DB at: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── BullMQ Redis ────────────────────────────────────────
# Separate from Upstash — BullMQ needs ioredis (TCP), not REST
# Create free DB at: https://redis.com/try-free
# Format: redis://:yourpassword@your-host.redis.cloud:12345
BULLMQ_REDIS_URL=redis://:yourpassword@your-host.redis.cloud:12345

# ─── Google AI / Gemini 2.0 Flash ────────────────────────
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# ─── Qdrant Vector DB (Step 17-18 — RAG) ─────────────────
# Run locally: docker run -p 6333:6333 qdrant/qdrant
# Or deploy on Railway: New Service → Docker → qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                  # leave empty for local dev; set for Railway deployment

# ─── Product Analytics (Step 20 — optional) ──────────────
# Free tier at: https://app.posthog.com
POSTHOG_API_KEY=

# ─── Error Tracking (Step 20 — optional) ─────────────────
# Self-hosted Sentry alternative. Free at: https://app.glitchtip.com
GLITCHTIP_DSN=

# ─── Server ──────────────────────────────────────────────
PORT=3000
